{
  "manifestVersion": 5,
  "id": "com.okpicker.oklch",
  "name": "OKLCH Picker",
  "version": "1.0.0",
  "main": "index.html",
  "host": [
    {
      "app": "PS",
      "minVersion": "26.0.0"
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "okpicker.panel",
      "label": {
        "default": "OKLCH Picker"
      },
      "minimumSize": {
        "width": 230,
        "height": 420
      },
      "maximumSize": {
        "width": 1200,
        "height": 2000
      },
      "preferredDockedSize": {
        "width": 280,
        "height": 580
      },
      "preferredFloatingSize": {
        "width": 320,
        "height": 640
      },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/icon@1x.png",
          "scale": [1],
          "theme": ["darkest", "dark", "medium", "light", "lightest"],
          "species": ["generic"]
        },
        {
          "width": 46,
          "height": 46,
          "path": "icons/icon@2x.png",
          "scale": [2],
          "theme": ["darkest", "dark", "medium", "light", "lightest"],
          "species": ["generic"]
        }
      ]
    }
  ],
  "requiredPermissions": {
    "clipboard": "readAndWrite"
  },
  "icons": [
    {
      "width": 23,
      "height": 23,
      "path": "icons/icon@1x.png",
      "scale": [1],
      "theme": ["darkest", "dark", "medium", "light", "lightest"],
      "species": ["generic"]
    },
    {
      "width": 46,
      "height": 46,
      "path": "icons/icon@2x.png",
      "scale": [2],
      "theme": ["darkest", "dark", "medium", "light", "lightest"],
      "species": ["generic"]
    }
  ]
}
