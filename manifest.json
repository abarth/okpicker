{
  "manifestVersion": 5,
  "id": "com.okpicker.oklch",
  "name": "OKLCH",
  "version": "1.0.0",
  "main": "index.html",
  "host": [
    {
      "app": "PS",
      "minVersion": "26.0.0"
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "okpicker.panel",
      "label": {
        "default": "OKLCH"
      },
      "minimumSize": {
        "width": 180,
        "height": 140
      },
      "maximumSize": {
        "width": 1200,
        "height": 2000
      },
      "preferredDockedSize": {
        "width": 260,
        "height": 380
      },
      "preferredFloatingSize": {
        "width": 300,
        "height": 440
      },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/icon@1x.png",
          "scale": [1],
          "theme": ["darkest", "dark", "medium", "light", "lightest"],
          "species": ["generic"]
        },
        {
          "width": 46,
          "height": 46,
          "path": "icons/icon@2x.png",
          "scale": [2],
          "theme": ["darkest", "dark", "medium", "light", "lightest"],
          "species": ["generic"]
        }
      ]
    },
    {
      "type": "panel",
      "id": "okpicker.underpaint",
      "label": {
        "default": "OKLCH Underpaint"
      },
      "minimumSize": {
        "width": 220,
        "height": 260
      },
      "maximumSize": {
        "width": 1200,
        "height": 2000
      },
      "preferredDockedSize": {
        "width": 300,
        "height": 720
      },
      "preferredFloatingSize": {
        "width": 340,
        "height": 760
      },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/paint@1x.png",
          "scale": [1],
          "theme": ["darkest", "dark", "medium", "light", "lightest"],
          "species": ["generic"]
        },
        {
          "width": 46,
          "height": 46,
          "path": "icons/paint@2x.png",
          "scale": [2],
          "theme": ["darkest", "dark", "medium", "light", "lightest"],
          "species": ["generic"]
        }
      ]
    }
  ],
  "icons": [
    {
      "width": 23,
      "height": 23,
      "path": "icons/icon@1x.png",
      "scale": [1],
      "theme": ["darkest", "dark", "medium", "light", "lightest"],
      "species": ["generic"]
    },
    {
      "width": 46,
      "height": 46,
      "path": "icons/icon@2x.png",
      "scale": [2],
      "theme": ["darkest", "dark", "medium", "light", "lightest"],
      "species": ["generic"]
    }
  ]
}
